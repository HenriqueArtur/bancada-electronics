{
  "name": "@bancada/electronics",
  "version": "0.1.0",
  "description": "Electronics plugin for bancada: ESP32 pin rules and a circuit drawing from diagram.json",
  "keywords": [
    "bancada",
    "bancada-plugin",
    "electronics",
    "esp32",
    "wokwi",
    "circuit"
  ],
  "homepage": "https://github.com/HenriqueArtur/bancada-electronics#readme",
  "bugs": {
    "url": "https://github.com/HenriqueArtur/bancada-electronics/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HenriqueArtur/bancada-electronics.git"
  },
  "license": "MIT",
  "author": "Henrique Artur <contato@henriqueartur.com>",
  "type": "module",
  "engines": {
    "bun": ">=1.3.0"
  },
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "bun test",
    "lint": "biome check src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@wokwi/elements": "1.9.2",
    "elkjs": "0.12.0"
  },
  "peerDependencies": {
    "bancada": "^0.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.14",
    "@types/bun": "1.3.14",
    "bancada": "0.1.0",
    "typescript": "5.9.3"
  }
}
